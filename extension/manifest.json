{
  "manifest_version": 3,
  "name": "Know Thyself Tracker",
  "version": "1.0.0",
  "description": "Tracks active time per website and uploads it to your Know Thyself account.",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Know Thyself Tracker" }
}